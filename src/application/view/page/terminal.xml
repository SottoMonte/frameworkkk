<?xml version="1.0" encoding="UTF-8"?>
<Window type="page" title="Omniport" background="#fdfbf7,#f5f2eb" font="sans">
    <Window id="confirm_dialog" type="modal">
        <Column>
            <Text height="80%">Sei sicuro di voler continuare?</Text>
            <Input type="text" id="confirm_input" placeholder="Scrivi qualcosa..." />
        </Column>
    </Window>
    <Row>
        <Input  height="20px" width="10%" submit="terminal:submit" placeholder="Scrivi qualcosa..." type="select" >
            <Text value="1">Macro</Text>
            <Text value="1">Micro</Text>
        </Input>
        <Input id="select" height="20px" submit="terminal:submit" placeholder="Scrivi qualcosa..." type="select" >
            <Text value="1">py.py</Text>
            <Text value="1">ggg.json</Text>
            <Text value="1">onsol.dsl</Text>
        </Input>
        <Action id="close" width="50px" type="button" click="modal:open:confirm_dialog" ><Text>IA</Text></Action>
    </Row>
    <Group type="tab" height="100%">
        <Column id="application" width="100%">
            <Input type="text" id="editor-application" height="88%" />
            <Navigation type="tabs">
                <Text id="sadss">main.py</Text>
                <Text id="sa1dss">page.xml</Text>
            </Navigation>
        </Column>
        <Column id="framework" width="100%">
            <Input type="text" id="editor-framework" height="90%" />
            <Navigation type="tabs">
                <Text id="sadss">Terminal</Text>
                <Text id="sa1dss">Terminal</Text>
            </Navigation>
        </Column>
        <Column id="infrastructure" width="100%">
            <Input type="text" id="editor-infrastructure" height="90%" />
            <Navigation type="tabs">
                <Text id="sadss">Terminal</Text>
                <Text id="sa1dss">Terminal</Text>
            </Navigation>
        </Column>
    </Group>
</Window>